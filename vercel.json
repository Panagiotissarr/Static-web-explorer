{
  "buildCommand": "curl -fsSL https://raw.githubusercontent.com/Panagiotissarr/Static-web-explorer/refs/heads/main/Scripts/regen.sh | bash",
  "outputDirectory": ".",
  "rewrites": [
    {
      "source": "/Assets/(.*)",
      "destination": "/Assets/$1"
    },
    {
      "source": "/Files/(.*)",
      "destination": "/Files/$1"
    },
    {
      "source": "/config.sarr",
      "destination": "/config.sarr"
    },
    {
      "source": "/(.*)",
      "destination": "/Index.html"
    }
  ]
}

